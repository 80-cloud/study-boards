# review-board backend 環境変数サンプル（実値は .env に書き、.env は Git にコミットしない）
# 機密の平文ハードコード禁止（母 SEC-9・CLAUDE.md §6）

# --- DB（docker-compose の PostgreSQL に合わせる。ポート 5434）---
DATABASE_URL=jdbc:postgresql://localhost:5434/reviewboard
DATABASE_USERNAME=reviewboard
DATABASE_PASSWORD=change-me-in-local

# --- JWT（HS256。十分に長いランダム文字列を設定。デフォルト値は持たせない＝fail-fast）---
JWT_SECRET=replace-with-32+chars-random-secret
JWT_COOKIE_SECURE=false

# --- ストレージ（ローカルは MinIO を S3 互換として使う）---
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=review-board
S3_REGION=ap-northeast-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- CORS（フロント Vite。ポート 5175 固定。CLAUDE.md §10）---
CORS_ALLOWED_ORIGIN=http://localhost:5175
