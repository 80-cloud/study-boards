# =====================================================================
# terraform.tfvars.example — 変数値の記入例（このファイルはコミットする）
# =====================================================================
# 使い方：このファイルを terraform.tfvars にコピーし、実値を記入する。
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars は .gitignore 済み（機密のため絶対にコミットしない）。
# =====================================================================

# SSH(22) を許可する自宅のグローバル IP（/32）。0.0.0.0/0 は禁止（validation で弾く）。
#   確認： curl -s https://checkip.amazonaws.com
my_ip_cidr = "203.0.113.10/32"

# RDS マスターパスワード（12文字以上）。tfstate に入るため tfstate も厳重管理。
db_password = "CHANGE_ME_strong_password_min12"

# JWT 署名鍵（32文字以上＝256bit 以上）。SSM SecureString に格納される。
#   生成例： openssl rand -base64 48
jwt_secret = "CHANGE_ME_base64_secret_at_least_32_chars_long"

# Budgets 通知先メール
budget_notify_email = "you@example.com"

# 必要なら上書き（既定は無料枠・ap-northeast-1）：
# instance_type      = "t3.micro"
# db_instance_class  = "db.t3.micro"
# ssh_public_key_path = "~/.ssh/aws-review-board.pub"
