{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAutomation",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:383158157670:document/PatchCanaryRollout",
        "arn:aws:ssm:ap-northeast-1:383158157670:automation-execution/*"
      ]
    },
    {
      "Sid": "PassAutomationAssumeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::383158157670:role/PatchCanaryDemo-AutomationAssumeRole",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ssm.amazonaws.com" }
      }
    }
  ]
}
